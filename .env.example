# Copy this file to .env and adjust values as needed.
# .env is gitignored; .env.example is the tracked template.

# Host UID that Airflow containers run as, so files written to mounted
# volumes (dags/, logs/, plugins/, config/) are owned by your host user
# instead of root. Run `id -u` to find yours.
AIRFLOW_UID=50000

# Fernet key used by Airflow to encrypt connection passwords/variables
# in the metadata database. Leave empty for local dev (Airflow will run
# without encryption); generate one for anything beyond local use:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Credentials for the Airflow webserver admin user created on first boot.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Airflow metadata database (airflow-postgres service).
AIRFLOW_DB_USER=airflow_db_user
AIRFLOW_DB_PASSWORD=airflow_1234
AIRFLOW_DB_NAME=airflow

# Warehouse database (warehouse-postgres service), used by dbt/ingestion.
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5433
WAREHOUSE_DB_USER=warehouse_db_user
WAREHOUSE_DB_PASSWORD=warehouse_1234
WAREHOUSE_DB_NAME=warehouse
